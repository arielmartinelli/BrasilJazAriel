# 1. SUPABASE (Base de datos PostgreSQL en la nube - Plan Free)
# Obtené estas claves en Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. CLOUDINARY (Hosting multimedia HD fotos y videos - Plan Free)
# Obtené estas credenciales en Cloudinary -> Dashboard
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Opcional:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
