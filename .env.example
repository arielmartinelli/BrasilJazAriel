# ==========================================================
# NOSSA HISTORIA - VARIABLES DE ENTORNO
# ==========================================================
# NUNCA pongas valores reales en este archivo. Es solo una plantilla.
# Los valores reales van en .env.local (local) y en Vercel > Settings >
# Environment Variables (produccion). Ambos estan fuera de git.
# ==========================================================

# ---------- 1. SUPABASE ----------
# Supabase -> Project Settings -> API
# La anon key viaja al navegador: es PUBLICA por diseno. Toda la seguridad
# real depende de las policies RLS de supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="TU_ANON_KEY_PUBLICA"

# SECRETO. Solo servidor. Salta todas las policies RLS.
# Si esta clave se filtra, cualquiera puede leer y borrar toda la base.
# Nunca la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="TU_SERVICE_ROLE_KEY"

# ---------- 2. CLOUDINARY ----------
# Cloudinary -> Dashboard. API_SECRET es secreto: solo servidor.
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# Publico: solo se usa para construir URLs de miniaturas optimizadas.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu-cloud-name"

# ---------- 3. ACCESO PRIVADO ----------
# Codigo compartido que Ariel y Jazmin escriben una vez por dispositivo.
# Sin esto, cualquiera con el link puede crear, editar y borrar recuerdos.
# Minimo 12 caracteres. Si se deja vacio, la app corre en modo abierto
# (solo para desarrollo local).
APP_ACCESS_CODE=""

# Clave para firmar la cookie de sesion. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# ---------- 4. SITIO ----------
NEXT_PUBLIC_SITE_URL="https://tu-dominio.vercel.app"
